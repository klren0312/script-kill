# 环境变量配置模板
# 复制为 .env 并填写实际值；.env 已被 git 忽略，不会提交密钥。
# 优先级：系统环境变量（如 Windows setx）> .env 文件。

# ant-ling 模型 API key（config/models.json 中 $ANT_LING_API_KEY）
ANT_LING_API_KEY=

# DeepSeek Anthropic 兼容网关 token（备用 provider deepseek-gw 的 $ANTHROPIC_AUTH_TOKEN，可选）
ANTHROPIC_AUTH_TOKEN=

# OpenRouter 模型 key（provider openrouter 的 $OPENROUTER_API_KEY，可选）
OPENROUTER_API_KEY=

# sensenova 模型 key（provider sensenova 的 $SENSENOVA_API_KEY，可选）
SENSENOVA_API_KEY=

# 跨域允许的来源（可选）：
# - 不设置或 * ：允许所有来源（默认，适合本地开发/局域网联机）
# - 逗号分隔的白名单：CORS_ORIGINS=https://a.example.com,https://b.example.com
CORS_ORIGINS=

